(version 1)
(rule "mains to low voltage"
  (constraint clearance (min 8.0mm))
  (condition "A.hasNetclass('Mains') && !B.hasNetclass('Mains') && B.Type != 'Zone'"))
(rule "mains to ground pour"
  (constraint clearance (min 8.0mm))
  (condition "A.hasNetclass('Mains') && B.Type == 'Zone'"))
(rule "mains to mains"
  (constraint clearance (min 2.5mm))
  (condition "A.hasNetclass('Mains') && B.hasNetclass('Mains') && A.Net != B.Net"))
(rule "mains to edge"
  (constraint edge_clearance (min 3.0mm))
  (condition "A.hasNetclass('Mains')"))
(rule "mains to holes"
  (constraint hole_clearance (min 3.0mm))
  (condition "A.hasNetclass('Mains')"))
