(footprint "MountingHole_M3_3.2mm_Pad6" (layer "F.Cu")
  (descr "M3 mounting hole on the low-voltage side: 3.2 mm plated drill and a 6 mm GND ring that doubles as the copper keep-out for a screw head or a heat-set insert")
  (attr exclude_from_pos_files exclude_from_bom)
  (fp_text reference "H**" (at 0 -4) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_text value "M3" (at 0 4) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_circle (center 0 0) (end 3.25 0) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_circle (center 0 0) (end 3.25 0) (stroke (width 0.05) (type solid)) (fill none) (layer "B.CrtYd"))
  (pad "1" thru_hole circle (at 0 0) (size 6 6) (drill 3.2) (layers "*.Cu" "*.Mask"))
)
