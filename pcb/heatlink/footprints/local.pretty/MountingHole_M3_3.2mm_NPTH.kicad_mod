(footprint "MountingHole_M3_3.2mm_NPTH" (layer "F.Cu")
  (descr "M3 mounting hole in the mains area: 3.2 mm unplated drill and no copper, so the screw is not connected to anything; the courtyard (7 mm) keeps parts clear of the screw head")
  (attr exclude_from_pos_files exclude_from_bom)
  (fp_text reference "H**" (at 0 -4.5) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_text value "M3 NPTH" (at 0 4.5) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_circle (center 0 0) (end 3.5 0) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_circle (center 0 0) (end 3.5 0) (stroke (width 0.05) (type solid)) (fill none) (layer "B.CrtYd"))
  (pad "" np_thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))
)
