{
  "manifest": {
    "manifestVersion": "1.0",
    "publishingInformation": {
      "locales": {
        "en-GB": {
          "name": "Nakostat",
          "summary": "Control the Nakostat heating thermostat.",
          "description": "Set and adjust the target temperature, switch the heating on or off, and ask for the current temperature of the Nakostat thermostat.",
          "examplePhrases": [
            "Alexa, set the heating to twenty degrees",
            "Alexa, turn up the heating",
            "Alexa, what's the temperature in here?"
          ],
          "keywords": ["thermostat", "heating", "nakostat"]
        }
      },
      "isAvailableWorldwide": false,
      "distributionCountries": ["GB"],
      "testingInstructions": "Private skill for the Nakostat home thermostat. Link with a Nakomis account.",
      "category": "SMART_HOME"
    },
    "apis": {
      "smartHome": {
        "endpoint": {
          "uri": "arn:aws:lambda:eu-west-1:ACCOUNT_ID:function:nakostat-alexa-ENV"
        },
        "regions": {
          "EU": {
            "endpoint": {
              "uri": "arn:aws:lambda:eu-west-1:ACCOUNT_ID:function:nakostat-alexa-ENV"
            }
          }
        },
        "protocolVersion": "3"
      }
    },
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportCompliant": true,
      "containsAds": false,
      "locales": {
        "en-GB": {
          "privacyPolicyUrl": "https://nakostat.nakomis.com/"
        }
      }
    }
  }
}
