{
  "name": "nakostat-infra",
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.1",
  "bin": {
    "nakostat": "bin/nakostat.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --coverage",
    "cdk": "cdk",
    "deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --profile nakom.is-sandbox --all --require-approval never",
    "deploy-prod": "NPM_ENVIRONMENT=prod cdk deploy --profile nakom.is-admin --all --require-approval never",
    "synth-sandbox": "NPM_ENVIRONMENT=sandbox cdk synth --profile nakom.is-sandbox --all",
    "synth-prod": "NPM_ENVIRONMENT=prod cdk synth --profile nakom.is --all",
    "ci-synth-sandbox": "NPM_ENVIRONMENT=sandbox cdk synth --all",
    "ci-deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --all --require-approval never --output cdk-deploy.out",
    "ci-deploy-prod": "NPM_ENVIRONMENT=prod cdk deploy --all --require-approval never --output cdk-deploy.out",
    "destroy-sandbox": "NPM_ENVIRONMENT=sandbox cdk destroy --profile nakom.is-sandbox --all",
    "destroy-prod": "NPM_ENVIRONMENT=prod cdk destroy --profile nakom.is-admin --all",
    "update-dependencies": "pnpm update --latest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-iot": "^3.0.0",
    "@aws-sdk/client-iot-data-plane": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "22.x",
    "aws-cdk": "^2.1145.0",
    "aws-sdk-client-mock": "^4.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
