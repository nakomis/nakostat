# The heatlink PCB v0.1 (pcb/heatlink, STAT-75), layered over sdkconfig.defaults:
#
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.board-v1" build
#
# Pins from pcb/heatlink/out/heatlink/pins.h. The board drives its relay through a low-side FET
# with a 100k gate pull-down, so it is active-high (push-pull), and off while the GPIO floats.
CONFIG_HEATLINK_RELAY_GPIO=12
# CONFIG_HEATLINK_RELAY_ACTIVE_LOW is not set
CONFIG_HEATLINK_SWITCH_ON_GPIO=13
CONFIG_HEATLINK_SWITCH_OFF_GPIO=14
CONFIG_HEATLINK_LED_GPIO=15
