menu "Nakostat heatlink"

config HEATLINK_RELAY_GPIO
    int "Relay module IN"
    range 0 48
    default 4

config HEATLINK_RELAY_ACTIVE_LOW
    bool "Relay module is active-low (open-drain)"
    default y
    help
        Most relay modules switch on when IN is pulled low. Active-low is driven open-drain: low = on,
        released = off (the module's own pull-up), which works whether the module runs at 3.3 V or
        5 V, and leaves the relay off while the GPIO floats at boot or reset. Say n for an
        active-high module, which is driven push-pull (high = on).

config HEATLINK_SWITCH_ON_GPIO
    int "Switch 'on' throw"
    range 0 48
    default 5
    help
        Internal pull-up; the switch's common goes to GND.

config HEATLINK_SWITCH_OFF_GPIO
    int "Switch 'off' throw"
    range 0 48
    default 6
    help
        Internal pull-up. The centre position (neither throw) is auto.

config HEATLINK_LED_GPIO
    int "WS2812 status LED"
    range 0 48
    default 48
    help
        The ESP32-S3-DevKitC-1's onboard RGB LED: GPIO 48 on v1.0 boards, 38 on v1.1.

config HEATLINK_LED_LEVEL
    int "Status LED brightness (0-255)"
    range 0 255
    default 40

config HEATLINK_OTA_DOWNLOAD_DEADLINE_S
    int "Longest an update's download may take (seconds)"
    default 300
    range 10 900
    help
        A download that takes longer than this is abandoned and backed off. A 1 MB image takes
        well under a minute. Lower only to test it.

endmenu
